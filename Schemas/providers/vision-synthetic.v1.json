{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:squidra:provider:vision-synthetic:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "provenance",
    "liveQualified",
    "modelId",
    "modelVersion",
    "coordinateSpace",
    "maskEncoding",
    "confidenceMeaning",
    "frames"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "provenance": {
      "type": "string",
      "const": "authored_synthetic"
    },
    "liveQualified": {
      "type": "boolean",
      "const": false
    },
    "modelId": {
      "type": "string",
      "const": "fixture.vision"
    },
    "modelVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "coordinateSpace": {
      "type": "string",
      "const": "source_pixels_xywh_half_open"
    },
    "maskEncoding": {
      "type": "string",
      "const": "row_major_binary"
    },
    "confidenceMeaning": {
      "type": "string",
      "const": "authored_test_value_not_measured_probability"
    },
    "frames": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "mediaType",
          "width",
          "height",
          "imageBase64",
          "imageSHA256",
          "detections"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "pattern": "^frame-[1-3]$",
            "maxLength": 7
          },
          "mediaType": {
            "type": "string",
            "const": "image/png"
          },
          "width": {
            "type": "integer",
            "const": 8
          },
          "height": {
            "type": "integer",
            "const": 8
          },
          "imageBase64": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]+={0,2}$",
            "minLength": 32,
            "maxLength": 4096
          },
          "imageSHA256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "detections": {
            "type": "array",
            "minItems": 0,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "localId",
                "label",
                "confidence",
                "box",
                "mask",
                "appearance"
              ],
              "properties": {
                "localId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$",
                  "minLength": 1,
                  "maxLength": 32
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "box": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height"
                  ],
                  "properties": {
                    "x": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 7
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 7
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 8
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 8
                    }
                  }
                },
                "mask": {
                  "type": "string",
                  "pattern": "^[01]{64}$",
                  "minLength": 64,
                  "maxLength": 64
                },
                "appearance": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
