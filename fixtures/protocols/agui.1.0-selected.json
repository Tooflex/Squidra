  "streams": [
    {
      "path": "spec/1.0/conformance/streams/current-peer-declares-protocol-version.json",
      "url": "https://raw.githubusercontent.com/ag-ui-protocol/ag-ui/1a9b3db4ea5145f263c66049e836c8896df66269/spec/1.0/conformance/streams/current-peer-declares-protocol-version.json",
      "sha256": "c1bc23ef82f05872ae6784f937b070b5350f82b78aad6a5a0a55a96e436ac534",
      "originalUTF8": "{\n  \"name\": \"current-peer-declares-protocol-version\",\n  \"area\": \"compatibility\",\n  \"description\": \"a client talking to a current peer declares the protocol version it speaks\",\n  \"specPage\": \"/spec/1.0/basic/versioning\",\n  \"kill\": \"stop declaring protocolVersion on the run input\",\n  \"stream\": [\n    { \"type\": \"RUN_STARTED\", \"threadId\": \"t-curpin\", \"runId\": \"r-1\", \"protocolVersion\": \"1.0\" },\n    { \"type\": \"RUN_FINISHED\", \"threadId\": \"t-curpin\", \"runId\": \"r-1\" }\n  ],\n  \"expect\": {\n    \"outcome\": \"completed\",\n    \"noWarnings\": true,\n    \"request\": { \"protocolVersion\": \"1.0\" }\n  }\n}\n"
    },
    {
      "path": "spec/1.0/conformance/streams/first-event-not-run-started-fatal.json",
      "url": "https://raw.githubusercontent.com/ag-ui-protocol/ag-ui/1a9b3db4ea5145f263c66049e836c8896df66269/spec/1.0/conformance/streams/first-event-not-run-started-fatal.json",
      "sha256": "913b1f8c47e75bb5862fa94c8847749580e054ad2e0a5d1438d58eb4542d2a82",
      "originalUTF8": "{\n  \"name\": \"first-event-not-run-started-fatal\",\n  \"area\": \"lifecycle\",\n  \"description\": \"a stream that opens with anything but RUN_STARTED or RUN_ERROR is a protocol violation\",\n  \"specPage\": \"/spec/1.0/events/lifecycle\",\n  \"kill\": \"drop the `!firstEventReceived` first-event check in verifyEvents so any event may open a stream\",\n  \"stream\": [\n    {\n      \"type\": \"TEXT_MESSAGE_START\",\n      \"messageId\": \"first-event-not-run-started-m-1\",\n      \"role\": \"assistant\"\n    }\n  ],\n  \"expect\": {\n    \"outcome\": \"failed\",\n    \"errorContains\": \"First event must be 'RUN_STARTED'\"\n  }\n}\n"
    },
    {
      "path": "spec/1.0/conformance/streams/nested-run-started-fatal.json",
      "url": "https://raw.githubusercontent.com/ag-ui-protocol/ag-ui/1a9b3db4ea5145f263c66049e836c8896df66269/spec/1.0/conformance/streams/nested-run-started-fatal.json",
      "sha256": "765216d58b9523faed91eef77e88c1649361b5629d851739d3aa4b8a69775fc9",
      "originalUTF8": "{\n  \"name\": \"nested-run-started-fatal\",\n  \"area\": \"lifecycle\",\n  \"description\": \"a second RUN_STARTED while a run is still active is fatal — a producer must close the current run before opening the next\",\n  \"specPage\": \"/spec/1.0/events/lifecycle\",\n  \"kill\": \"drop the `runStarted && !runFinished && !runError` guard in verifyEvents so a run may be nested inside another\",\n  \"stream\": [\n    {\n      \"type\": \"RUN_STARTED\",\n      \"threadId\": \"t-nested-run-started\",\n      \"runId\": \"nested-run-started-r-1\",\n      \"protocolVersion\": \"1.0\"\n    },\n    {\n      \"type\": \"RUN_STARTED\",\n      \"threadId\": \"t-nested-run-started\",\n      \"runId\": \"nested-run-started-r-2\",\n      \"protocolVersion\": \"1.0\"\n    }\n  ],\n  \"expect\": {\n    \"outcome\": \"failed\",\n    \"errorContains\": \"Cannot send 'RUN_STARTED' while a run is still active\"\n  }\n}\n"
    },
    {
      "path": "spec/1.0/conformance/streams/event-after-run-finished-fatal.json",
      "url": "https://raw.githubusercontent.com/ag-ui-protocol/ag-ui/1a9b3db4ea5145f263c66049e836c8896df66269/spec/1.0/conformance/streams/event-after-run-finished-fatal.json",
      "sha256": "2f1cef66b153713c362f9be70a18b67d4acaa7c62455ccb71494584daae226c0",
      "originalUTF8": "{\n  \"name\": \"event-after-run-finished-fatal\",\n  \"area\": \"lifecycle\",\n  \"description\": \"an ordinary event after RUN_FINISHED is fatal — only RUN_STARTED and RUN_ERROR may follow a closed run\",\n  \"specPage\": \"/spec/1.0/events/lifecycle\",\n  \"kill\": \"drop the `runFinished` guard in verifyEvents so events keep flowing after a run closes\",\n  \"stream\": [\n    {\n      \"type\": \"RUN_STARTED\",\n      \"threadId\": \"t-event-after-run-finished\",\n      \"runId\": \"event-after-run-finished-r-1\",\n      \"protocolVersion\": \"1.0\"\n    },\n    {\n      \"type\": \"RUN_FINISHED\",\n      \"threadId\": \"t-event-after-run-finished\",\n      \"runId\": \"event-after-run-finished-r-1\"\n    },\n    {\n      \"type\": \"TEXT_MESSAGE_START\",\n      \"messageId\": \"event-after-run-finished-m-1\",\n      \"role\": \"assistant\"\n    }\n  ],\n  \"expect\": {\n    \"outcome\": \"failed\",\n    \"errorContains\": \"The run has already finished with 'RUN_FINISHED'\"\n  }\n}\n"
    },
    {
      "path": "spec/1.0/conformance/streams/open-message-at-run-finished-fatal.json",
      "url": "https://raw.githubusercontent.com/ag-ui-protocol/ag-ui/1a9b3db4ea5145f263c66049e836c8896df66269/spec/1.0/conformance/streams/open-message-at-run-finished-fatal.json",
      "sha256": "239de7e76cc3ae7b0028866170348cba6af36bf2c4c51a3194cfc9900a15d026",
      "originalUTF8": "{\n  \"name\": \"open-message-at-run-finished-fatal\",\n  \"area\": \"lifecycle\",\n  \"description\": \"RUN_FINISHED while a text message is still open is fatal — everything the run opened must be closed first\",\n  \"specPage\": \"/spec/1.0/events/lifecycle\",\n  \"kill\": \"drop the activeMessages check in the RUN_FINISHED case of verifyEvents so a run may close over an open message\",\n  \"stream\": [\n    {\n      \"type\": \"RUN_STARTED\",\n      \"threadId\": \"t-open-message-at-run-finished\",\n      \"runId\": \"open-message-at-run-finished-r-1\",\n      \"protocolVersion\": \"1.0\"\n    },\n    {\n      \"type\": \"TEXT_MESSAGE_START\",\n      \"messageId\": \"open-message-at-run-finished-m-1\",\n      \"role\": \"assistant\"\n    },\n    {\n      \"type\": \"TEXT_MESSAGE_CONTENT\",\n      \"messageId\": \"open-message-at-run-finished-m-1\",\n      \"delta\": \"never closed\"\n    },\n    {\n      \"type\": \"RUN_FINISHED\",\n      \"threadId\": \"t-open-message-at-run-finished\",\n      \"runId\": \"open-message-at-run-finished-r-1\"\n    }\n  ],\n  \"expect\": {\n    \"outcome\": \"failed\",\n    \"errorContains\": \"Cannot send 'RUN_FINISHED' while text messages are still active\"\n  }\n}\n"
    },
    {
      "path": "spec/1.0/conformance/streams/content-without-start-fatal.json",
      "url": "https://raw.githubusercontent.com/ag-ui-protocol/ag-ui/1a9b3db4ea5145f263c66049e836c8896df66269/spec/1.0/conformance/streams/content-without-start-fatal.json",
      "sha256": "fe881c0e5a1e3d853baeec000598e4a1f43e3bf2f1def3e165d9ad39c5eb9ed5",
      "originalUTF8": "{\n  \"name\": \"content-without-start-fatal\",\n  \"area\": \"streaming\",\n  \"description\": \"a content event for an identifier that is not open is a protocol violation, not a message the consumer invents\",\n  \"specPage\": \"/spec/1.0/basic/patterns/streaming\",\n  \"kill\": \"make verification create the message on TEXT_MESSAGE_CONTENT when none is open instead of rejecting the event\",\n  \"stream\": [\n    { \"type\": \"RUN_STARTED\", \"threadId\": \"t-orphan-content\", \"runId\": \"orphan-content-r1\", \"protocolVersion\": \"1.0\" },\n    { \"type\": \"TEXT_MESSAGE_CONTENT\", \"messageId\": \"orphan-content-m1\", \"delta\": \"nothing is open\" },\n    { \"type\": \"RUN_FINISHED\", \"threadId\": \"t-orphan-content\", \"runId\": \"orphan-content-r1\" }\n  ],\n  \"expect\": {\n    \"outcome\": \"failed\",\n    \"errorContains\": \"No active text message found with ID 'orphan-content-m1'\"\n  }\n}\n"
    }
  ]
}
